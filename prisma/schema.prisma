generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id          Int     @id @default(1)
  fullName    String
  headline    String
  shortIntro  String
  aboutText   String  @db.Text
  location    String?
  photoUrl    String
  email       String?
  githubUrl   String?
  linkedinUrl String?
}
